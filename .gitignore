# Dependencies - Prevents uploading thousands of package files
node_modules

# Environment Variables - Protects your MongoDB password
.env

# Firebase Service Account Key - Protects your Firebase project admin key
serviceAccountKey.json
api/serviceAccountKey.json

# OpenCode local config (may contain API keys)
.opencode.json
.vercel

# Local server logs
server.log
server.err.log

# QA screenshots — kept local-only (regenerable via the browser harness;
# share via GitHub issue/PR attachments instead of committing binaries)
artifacts/*.png
