# Linkly environment variables (copy to .env for local development).
# Never commit real secrets.

# MongoDB Atlas connection string. Use a dedicated database user with
# readWrite access to the Linkly database only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkly

# Local server port (Vercel ignores this).
PORT=5000

# Firebase Admin service account. Either set the full JSON (or base64-encoded
# JSON) here, or keep the service-account file at api/serviceAccountKey.json.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=https://linkly-link.vercel.app

# Optional host allowlist for generated short URLs (comma-separated).
ALLOWED_HOSTS=

# Shorten requests per IP per window (0 disables IP limiting).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# New links per signed-in user per UTC day (0 disables the daily quota).
DAILY_LINK_QUOTA=50

# Secret used to hash (IP + user-agent + day) into a rotating unique-visitor
# identifier. Leave empty to disable unique-visitor counts. Use a long random
# value; rotating it resets uniques without touching historical click records.
VISITOR_HASH_SECRET=

# Vercel Cron calls /api/cleanup with this bearer token. Required for cleanup.
CRON_SECRET=

# Firebase UIDs allowed to disable/enable links via POST /api/admin.
ADMIN_UIDS=
